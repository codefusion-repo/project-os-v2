{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json",
  "title": "Project OS v2 manifest support bundle",
  "description": "Static manifest support-discovery bundle schema. This schema validates curated reference shape only and does not claim complete inventory, generated index behavior, loading behavior, selector runtime, Resolver behavior, runtime behavior, command execution, or write authorization.",
  "$defs": {
    "contractEntry": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractRef"
        },
        "contract_kind": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractKind"
        },
        "entity_family": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractFamilyRef"
        },
        "path": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/status"
        },
        "version": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/versionV1"
        }
      },
      "required": [
        "contract_id",
        "path",
        "entity_family",
        "contract_kind",
        "version",
        "status"
      ],
      "type": "object"
    },
    "contractFamilyEntry": {
      "additionalProperties": false,
      "properties": {
        "contract_kind": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractKind"
        },
        "directory_path": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "entity_family": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractFamilyRef"
        },
        "status_policy": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        }
      },
      "required": [
        "entity_family",
        "directory_path",
        "contract_kind",
        "status_policy"
      ],
      "type": "object"
    },
    "curationBoundaryPolicy": {
      "additionalProperties": false,
      "properties": {
        "complete_inventory": {
          "const": false
        },
        "generated": {
          "const": false
        },
        "loader_behavior": {
          "const": false
        },
        "resolver_behavior": {
          "const": false
        },
        "runtime_behavior": {
          "const": false
        },
        "selector_runtime_behavior": {
          "const": false
        },
        "static_curated": {
          "const": true
        },
        "write_authorization_behavior": {
          "const": false
        }
      },
      "required": [
        "generated",
        "static_curated",
        "complete_inventory",
        "loader_behavior",
        "runtime_behavior",
        "selector_runtime_behavior",
        "resolver_behavior",
        "write_authorization_behavior"
      ],
      "type": "object"
    },
    "deprecatedRelationshipRef": {
      "additionalProperties": false,
      "properties": {
        "active_resolver_candidate": {
          "const": false
        },
        "canonical_replacement_ref": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
        },
        "provenance_discoverable_only": {
          "const": true
        },
        "relationship_type_ref": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
        }
      },
      "required": [
        "relationship_type_ref",
        "provenance_discoverable_only",
        "active_resolver_candidate",
        "canonical_replacement_ref"
      ],
      "type": "object"
    },
    "relationshipContractEntry": {
      "additionalProperties": false,
      "properties": {
        "active_resolver_candidate": {
          "const": false
        },
        "contract_id": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
        },
        "path": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "provenance_discoverable_only": {
          "const": true
        },
        "relationship_type_ref": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
        },
        "status": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/status"
        },
        "version": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/versionV1"
        }
      },
      "required": [
        "contract_id",
        "path",
        "relationship_type_ref",
        "version",
        "status"
      ],
      "type": "object"
    },
    "relationshipFamilyEntry": {
      "additionalProperties": false,
      "properties": {
        "contract_kind": {
          "const": "relationship"
        },
        "directory_path": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "relationship_type_ref": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
        },
        "status_policy": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        }
      },
      "required": [
        "relationship_type_ref",
        "directory_path",
        "contract_kind",
        "status_policy"
      ],
      "type": "object"
    },
    "supportDiscoveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "complete_inventory": {
          "const": false
        },
        "curated_support_discovery_only": {
          "const": true
        },
        "loader_behavior": {
          "const": false
        },
        "resolver_behavior": {
          "const": false
        },
        "runtime_behavior": {
          "const": false
        },
        "selector_runtime_behavior": {
          "const": false
        },
        "write_authorization_behavior": {
          "const": false
        }
      },
      "required": [
        "curated_support_discovery_only",
        "complete_inventory",
        "loader_behavior",
        "runtime_behavior",
        "selector_runtime_behavior",
        "resolver_behavior",
        "write_authorization_behavior"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "const": "non_entity_static_reference_bundle"
    },
    "contract_kind": {
      "const": "manifest"
    },
    "descripcion": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "id": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/manifestContractId"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "body_inclusion_policy": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "contract_entries": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/contractEntry"
          },
          "type": "array"
        },
        "contract_family_entries": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/contractFamilyEntry"
          },
          "type": "array"
        },
        "contract_root_path": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "curation_policy": {
          "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/curationBoundaryPolicy"
        },
        "deprecated_reserved_relationship_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/deprecatedRelationshipRef"
          },
          "type": "array",
          "uniqueItems": true
        },
        "index_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/indexContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "inventory_scope": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "live_evidence_policy": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "manifest_kind": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "nombre": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "policy_bundle_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/policyContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "relationship_contract_entries": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/relationshipContractEntry"
          },
          "type": "array"
        },
        "relationship_family_entries": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/relationshipFamilyEntry"
          },
          "type": "array"
        },
        "represented_entity_families": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/entityFamily"
          },
          "type": "array",
          "uniqueItems": true
        },
        "represented_static_reference_sets": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/supportReferenceSet"
          },
          "type": "array",
          "uniqueItems": true
        },
        "resolver_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/resolverContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "selector_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/selectorContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "support_discovery_policy": {
          "$ref": "https://schemas.project-os-v2.local/support/manifest.bundle.v1.schema.json#/$defs/supportDiscoveryPolicy"
        }
      },
      "required": [
        "nombre",
        "manifest_kind",
        "contract_root_path",
        "inventory_scope",
        "support_discovery_policy",
        "deprecated_reserved_relationship_refs",
        "resolver_refs",
        "policy_bundle_refs",
        "index_refs",
        "selector_refs",
        "represented_entity_families",
        "represented_static_reference_sets",
        "contract_family_entries",
        "contract_entries",
        "relationship_family_entries",
        "relationship_contract_entries",
        "body_inclusion_policy",
        "live_evidence_policy",
        "curation_policy"
      ],
      "type": "object"
    },
    "schema_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
    },
    "source_refs": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/sourceRefs"
    },
    "status": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/status"
    },
    "version": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/versionV1"
    }
  },
  "required": [
    "id",
    "classification",
    "contract_kind",
    "version",
    "status",
    "schema_ref",
    "descripcion",
    "source_refs",
    "payload"
  ],
  "type": "object"
}
