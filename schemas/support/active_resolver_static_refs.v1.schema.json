{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/support/active_resolver_static_refs.v1.schema.json",
  "title": "Project OS v2 active Resolver static refs",
  "description": "Standalone data-shape schema for active Resolver static references. This schema validates reference shape only and does not populate schema_ref values, load contracts, select context, execute commands, or authorize writes.",
  "additionalProperties": false,
  "properties": {
    "fallback_estado_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/estadoContractId"
    },
    "index_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/indexContractId"
    },
    "input_schema_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
    },
    "manifest_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/manifestContractId"
    },
    "output_schema_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
    },
    "policy_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/policyContractId"
    },
    "resolver_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/resolverContractId"
    },
    "selector_refs": {
      "items": {
        "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/selectorContractId"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "resolver_ref",
    "manifest_ref",
    "policy_ref",
    "index_ref",
    "selector_refs",
    "input_schema_ref",
    "output_schema_ref",
    "fallback_estado_ref"
  ],
  "type": "object"
}
