{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/support/policy.bundle.v1.schema.json",
  "title": "Project OS v2 policy support bundle",
  "description": "Static policy reference bundle schema. This schema validates reference-bundle data shape only and does not implement policy execution, loading, Resolver behavior, selector runtime, command execution, or write authorization.",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "const": "non_entity_static_reference_bundle"
    },
    "contract_kind": {
      "const": "reference_bundle"
    },
    "descripcion": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "id": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/policyContractId"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "allowed_actor_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/actorContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "applies_to_resolver_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/resolverContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "bundle_kind": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "evidence_category_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/evidenciaContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fallback_estado_ref": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/estadoContractId"
        },
        "limit_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/limiteContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "nombre": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/nonEmptyString"
        },
        "relationship_instance_refs": {
          "additionalProperties": false,
          "properties": {
            "actor_limit_refs": {
              "items": {
                "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "limit_failure_state_refs": {
              "items": {
                "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "role_rule_refs": {
              "items": {
                "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "rule_failure_state_refs": {
              "items": {
                "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "actor_limit_refs",
            "role_rule_refs",
            "limit_failure_state_refs",
            "rule_failure_state_refs"
          ],
          "type": "object"
        },
        "relationship_type_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/relacionContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rule_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/reglaContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schema_ref_policy": {
          "additionalProperties": false,
          "properties": {
            "input_schema_ref": {
              "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
            },
            "output_schema_ref": {
              "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
            }
          },
          "required": [
            "input_schema_ref",
            "output_schema_ref"
          ],
          "type": "object"
        },
        "source_authority_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/fuenteContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "state_refs": {
          "items": {
            "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/estadoContractId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "static_data_refs": {
          "additionalProperties": false,
          "properties": {
            "index_ref": {
              "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/indexContractId"
            },
            "manifest_ref": {
              "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/manifestContractId"
            },
            "selector_refs": {
              "items": {
                "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/selectorContractId"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "manifest_ref",
            "index_ref",
            "selector_refs"
          ],
          "type": "object"
        },
        "tooling_gate_refs": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractRefArray"
        }
      },
      "required": [
        "nombre",
        "bundle_kind",
        "applies_to_resolver_refs",
        "allowed_actor_refs",
        "limit_refs",
        "rule_refs",
        "state_refs",
        "source_authority_refs",
        "evidence_category_refs",
        "relationship_type_refs",
        "relationship_instance_refs",
        "tooling_gate_refs",
        "fallback_estado_ref",
        "schema_ref_policy",
        "static_data_refs"
      ],
      "type": "object"
    },
    "schema_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
    },
    "source_refs": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/sourceRefs"
    },
    "status": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/status"
    },
    "version": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/versionV1"
    }
  },
  "required": [
    "id",
    "classification",
    "contract_kind",
    "version",
    "status",
    "schema_ref",
    "descripcion",
    "source_refs",
    "payload"
  ],
  "type": "object"
}
