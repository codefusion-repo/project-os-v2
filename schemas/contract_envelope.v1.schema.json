{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/contract_envelope.v1.schema.json",
  "title": "Project OS v2 contract envelope",
  "description": "Shared Project OS v2 contract envelope. This schema validates static contract shape only and does not implement loading, Resolver behavior, runtime behavior, command execution, or write authorization.",
  "additionalProperties": false,
  "properties": {
    "contract_kind": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractKind"
    },
    "descripcion": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "entity_family": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/entityFamilyOrNull"
    },
    "id": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/contractRef"
    },
    "payload": {
      "type": "object"
    },
    "schema_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/schemaRefOrNull"
    },
    "source_refs": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/sourceRefs"
    },
    "status": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/status"
    },
    "version": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/versionV1"
    }
  },
  "required": [
    "id",
    "entity_family",
    "contract_kind",
    "version",
    "status",
    "schema_ref",
    "descripcion",
    "source_refs",
    "payload"
  ],
  "type": "object"
}
