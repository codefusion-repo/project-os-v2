{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json",
  "title": "Project OS v2 ResolverInput data shape",
  "description": "Standalone ResolverInput data-shape schema for normalized request and evidence references. This schema validates static input shape only and does not implement Resolver behavior, loading, selector runtime, command execution, or write authorization.",
  "$defs": {
    "accionRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/accionContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "actorRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/actorContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "artefactoRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/artefactoContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "plantillaRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/plantillaContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "recursoRefArray": {
      "items": {
        "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/recursoContractId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "rolRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/rolContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/scopeContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflowRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/workflowContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflowStepRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/workflowStepContractId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "additionalProperties": true,
      "type": "object"
    },
    "current_actor_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/actorRefOrNull"
    },
    "current_branch_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "current_request": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "evidence_refs": {
      "items": {
        "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/evidenciaContractId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "issue_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "live_evidence_refs": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/sourceRefs"
    },
    "repository_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "request_ref": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/stringOrNull"
    },
    "requested_action_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/accionRefOrNull"
    },
    "requested_output_artifact_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/artefactoRefOrNull"
    },
    "requested_resource_refs": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/recursoRefArray"
    },
    "requested_role_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/rolRefOrNull"
    },
    "requested_scope_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/scopeRefOrNull"
    },
    "requested_template_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/plantillaRefOrNull"
    },
    "requested_workflow_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/workflowRefOrNull"
    },
    "requested_workflow_step_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/workflowStepRefOrNull"
    },
    "resolver_static_refs": {
      "$ref": "https://schemas.project-os-v2.local/support/active_resolver_static_refs.v1.schema.json"
    },
    "source_refs": {
      "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/sourceRefs"
    },
    "target_actor_ref": {
      "$ref": "https://schemas.project-os-v2.local/resolver_input.v1.schema.json#/$defs/actorRefOrNull"
    }
  },
  "required": [
    "request_ref",
    "current_request",
    "repository_ref",
    "issue_ref",
    "current_branch_ref",
    "current_actor_ref",
    "target_actor_ref",
    "requested_role_ref",
    "requested_workflow_ref",
    "requested_workflow_step_ref",
    "requested_action_ref",
    "requested_resource_refs",
    "requested_scope_ref",
    "requested_output_artifact_ref",
    "requested_template_ref",
    "resolver_static_refs",
    "source_refs",
    "evidence_refs",
    "live_evidence_refs",
    "constraints"
  ],
  "type": "object"
}
