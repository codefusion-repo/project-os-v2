{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolver.contract.v1.schema.json",
  "title": "Project OS v2 resolver family contract",
  "allOf": [
    {
      "$ref": "../contract_envelope.v1.schema.json"
    },
    {
      "properties": {
        "contract_kind": {
          "const": "entity"
        },
        "entity_family": {
          "const": "resolver"
        },
        "id": {
          "$ref": "../common_defs.v1.schema.json#/$defs/resolverContractId"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "fallback_estado_id": {
              "$ref": "../common_defs.v1.schema.json#/$defs/contractRefOrNull"
            },
            "input_schema_ref": {
              "$ref": "../common_defs.v1.schema.json#/$defs/schemaRefOrNull"
            },
            "manifest_ref": {
              "$ref": "../common_defs.v1.schema.json#/$defs/contractRefOrNull"
            },
            "nombre": {
              "$ref": "../common_defs.v1.schema.json#/$defs/stringOrNull"
            },
            "output_schema_ref": {
              "$ref": "../common_defs.v1.schema.json#/$defs/schemaRefOrNull"
            },
            "policy_ref": {
              "$ref": "../common_defs.v1.schema.json#/$defs/contractRefOrNull"
            }
          },
          "required": [
            "nombre",
            "manifest_ref",
            "policy_ref",
            "input_schema_ref",
            "output_schema_ref",
            "fallback_estado_id"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  ]
}
