{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accion.contract.v1.schema.json",
  "title": "Project OS v2 accion family contract",
  "allOf": [
    {
      "$ref": "../contract_envelope.v1.schema.json"
    },
    {
      "properties": {
        "contract_kind": {
          "const": "entity"
        },
        "entity_family": {
          "const": "accion"
        },
        "id": {
          "$ref": "../common_defs.v1.schema.json#/$defs/accionContractId"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "nombre": {
              "$ref": "../common_defs.v1.schema.json#/$defs/stringOrNull"
            },
            "tipo": {
              "$ref": "../common_defs.v1.schema.json#/$defs/stringOrNull"
            }
          },
          "required": [
            "nombre",
            "tipo"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  ]
}
