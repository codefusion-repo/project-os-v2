{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.project-os-v2.local/resolver_output.v1.schema.json",
  "title": "Project OS v2 ResolverOutput data shape",
  "description": "Standalone ResolverOutput data-shape schema for reference-based effective context materialization. This schema validates output shape only and does not implement Resolver behavior, loading, selector runtime, command execution, or write authorization.",
  "$defs": {
    "artefactoRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/artefactoContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "estadoRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/estadoContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "indexRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/indexContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifestRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/manifestContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "plantillaRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/plantillaContractId"
