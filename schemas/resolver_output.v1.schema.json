        }
      ]
    },
    "policyRefOrNull": {
      "anyOf": [
        {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/policyContractId"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonGroups": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/staticStringArray"
        },
        "needs_context": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/staticStringArray"
        },
        "needs_pm_decision": {
          "$ref": "https://schemas.project-os-v2.local/common_defs.v1.schema.json#/$defs/staticStringArray"
        }
      },
      "required": [
        "blocked",
        "needs_context",
        "needs_pm_decision"
      ],
      "type": "object"
    },
